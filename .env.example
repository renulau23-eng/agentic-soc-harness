# Copy to .env and adjust. All settings are prefixed ASH_.

ASH_ENVIRONMENT=development            # development | staging | production
ASH_LOG_LEVEL=INFO
ASH_LOG_JSON=true

# Persistence — SQLite for dev, PostgreSQL for production (pip install '.[postgres]')
ASH_DATABASE_URL=sqlite:///./ash.db
# ASH_DATABASE_URL=postgresql+psycopg://ash:ash@postgres:5432/ash

# Auth
ASH_JWT_SECRET=replace-with-32-plus-random-bytes
ASH_JWT_TTL_SECONDS=3600
ASH_USERS_FILE=config/users.example.yaml
# Service accounts: key:name:role1|role2,key2:name2:role
ASH_API_KEYS=siem-ingest-key-change-me:siem:service
# Dev only (refused in production):
ASH_BOOTSTRAP_ADMIN_PASSWORD=admin

# Governance
ASH_POLICY_FILE=config/policy.yaml
ASH_APPROVAL_TTL_SECONDS=14400
ASH_RATE_LIMIT_PER_MINUTE=120
# Protective plane (AgentPEP / LLM Firewall / Thoth) — POST {stage,payload,meta} → {allow,reason,payload}
# ASH_GUARDRAIL_WEBHOOK_URL=http://agentpep.soc.local/evaluate

# Models — either a YAML file or env-defined profiles (env wins).
# ASH_MODELS_FILE=config/models.example.yaml
ASH_DEFAULT_MODEL_PROFILE=reasoning
ASH_MAX_AGENT_STEPS=12

# Offline (no GPU) — deterministic SOC playbook model:
ASH_MODEL_REASONING_PROVIDER=mock
ASH_MODEL_REASONING_MODEL=soc-playbook

# Nemotron on a local NIM / vLLM:
# ASH_MODEL_REASONING_PROVIDER=nemotron
# ASH_MODEL_REASONING_BASE_URL=http://nim.soc.local:8000/v1
# ASH_MODEL_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
# ASH_MODEL_REASONING_API_KEY=
# ASH_MODEL_REASONING_REASONING=true

# Sovereign model when ready:
# ASH_MODEL_REASONING_PROVIDER=sovereign
# ASH_MODEL_REASONING_BASE_URL=http://sovereign.soc.local:8000/v1
# ASH_MODEL_REASONING_MODEL=coe/sovereign-7b-soc
